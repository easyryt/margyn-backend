{
  "name": "margyn-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "admin:grant": "node --env-file-if-exists=.env scripts/grant-admin.mjs",
    "services:check": "node --env-file-if-exists=.env scripts/check-services.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-sqlite.mjs",
    "brand:migrate": "node --env-file-if-exists=.env scripts/rebrand.mjs"
  },
  "dependencies": {
    "@countrystatecity/countries": "3.0.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.8.0",
    "mongoose": "^9.9.2",
    "multer": "^2.0.0",
    "pdf-lib": "1.17.1",
    "pdf2json": "4.0.3",
    "sharp": "0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "jszip": "3.10.1",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "5.9.3"
  }
}
