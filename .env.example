# Local development binding. Render automatically uses 0.0.0.0 and its PORT.
HOST=127.0.0.1
PORT=4000
# Frontend origins allowed to make browser requests (comma separated, no trailing slash).
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/
# Shared database for marketplace and private per-account tool collections.
MONGODB_DB=margyn_marketplace
# Optional fallback when the machine cannot resolve Atlas SRV records.
MONGODB_DNS_SERVERS=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/t9rd9hyjk
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
OTP_PROVIDER=development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SHIPPING_FLAT_RATE=79
FREE_SHIPPING_ABOVE=999
# Enable only behind a trusted reverse proxy that replaces forwarded headers.
TRUST_PROXY=false
# Optional location of the previous SQLite backup, for the migration script only.
LEGACY_DATA_DIR=../margyn-2026/.data
# Image Generator: provider keys stay in this backend only.
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_IMAGE_MODEL=
GEMINI_CONTENT_MODEL=
GEMINI_IMAGE_SIZE=
OPENAI_IMAGE_MODEL=
OPENAI_CONTENT_MODEL=
OPENAI_IMAGE_QUALITY=
GEMINI_REFERENCE_MAX_EDGE=
GEMINI_ANALYSIS_MAX_EDGE=
GEMINI_MAX_OUTPUT_TOKENS=
OPENAI_REFERENCE_MAX_EDGE=
OPENAI_ANALYSIS_MAX_EDGE=
OPENAI_MAX_OUTPUT_TOKENS=
# AI plans use Razorpay TEST mode only. Never put the secret in frontend variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional separate secret configured for the Razorpay webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=

# Optional Listing Tool overrides; original handler defaults apply when blank.
LISTING_AI_PROVIDER=
LISTING_GEMINI_CONTENT_MODEL=
LISTING_OPENAI_CONTENT_MODEL=
